# Mythara Engine Production Environment Variables
# Copyright © 2026 Mythara Labs LLC. All rights reserved.

# ============================================================================
# REQUIRED - Must be set for production deployment
# ============================================================================

# API Keys (comma-separated JSON objects)
# Example: MYTHARA_API_KEYS='{"key1":{"name":"Corp A","roles":["read","invoke"]}}'
MYTHARA_API_KEYS=

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://mythara_app:CHANGEME_SET_VIA_ENV@localhost:5432/mythara_production

# Redis connection (for rate limiting and caching)
REDIS_URL=redis://host:6379/0

# Secret key for HMAC signing (generate with: openssl rand -hex 32)
MYTHARA_SECRET_KEY=

# Admin token for admin endpoints
MYTHARA_ADMIN_TOKEN=

# ============================================================================
# OPTIONAL - Platform integrations
# ============================================================================

# ElevenLabs voice synthesis
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Email service (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@mythara.ai

# Stripe payment processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# CONFIGURATION - Application settings
# ============================================================================

# Environment mode
MYTHARA_ENV=production

# License mode (trial, pilot, enterprise, sovereign)
MYTHARA_LICENSE_MODE=enterprise

# CORS allowed origins (comma-separated)
MYTHARA_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable structured JSON logging
STRUCTURED_LOGGING=true

# ============================================================================
# MONITORING - External services
# ============================================================================

# Sentry error tracking
SENTRY_DSN=

# Datadog APM
DD_AGENT_HOST=
DD_SERVICE=mythara-engine
DD_ENV=production

# ============================================================================
# SECURITY - Additional hardening
# ============================================================================

# Rate limiting (requests per minute)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_TRIAL=10
RATE_LIMIT_PILOT=100
RATE_LIMIT_ENTERPRISE=1000

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# API key rotation interval (days)
API_KEY_ROTATION_DAYS=90

# ============================================================================
# PERFORMANCE - Optimization settings
# ============================================================================

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis connection pool
REDIS_POOL_SIZE=10

# Worker count (for uvicorn)
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30
